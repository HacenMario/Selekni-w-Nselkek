# ── Frontend (Vercel) ──────────────────────────────────────────
# Railway API base URL in production (e.g. https://slekni-api.up.railway.app).
# Leave EMPTY for local dev / sandbox preview (uses the gateway + port below).
NEXT_PUBLIC_API_URL=http://localhost:3100
# Local API port for the sandbox gateway (XTransformPort)
NEXT_PUBLIC_API_PORT=3100
# Web Push public key (VAPID) — must match VAPID_PUBLIC_KEY on the backend
