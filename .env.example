# ══════════════════════════════════════════════════════════════
# Selekni w Nselkek — environment variables template
# Frontend file. The backend template lives at:
#   mini-services/api-server/.env.example
# ══════════════════════════════════════════════════════════════

# ── Frontend (Vercel) ──────────────────────────────────────────
# ★★★ ملف السيرفر (API Base URL) — هذا هو الموضع الذي تبحث عنه ★★★
# انسخ رابط خدمة Railway (Domains → production.up.railway.app) وألصقه بعد =
# بدون شرطة مائلة في النهاية، مثال:
#   NEXT_PUBLIC_API_URL=https://slekni-api-production.up.railway.app
# ثم على Vercel: Settings → Environment Variables → أضف نفس المتغير واعمل Redeploy
# (متغيرات NEXT_PUBLIC_* تُثبَّت وقت البناء فلا تعمل إلا بعد إعادة النشر).
# Leave EMPTY for the sandbox preview (uses the gateway). Locally: either leave
# empty (next.config.ts rewrites /api/* to localhost:3100) or set it to
# http://localhost:3100 to call the API directly.
NEXT_PUBLIC_API_URL=
# Local API port for the sandbox gateway (XTransformPort)
NEXT_PUBLIC_API_PORT=3100
# Web Push public key (VAPID) — must match VAPID_PUBLIC_KEY on the backend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGsBTZg_pYD4Cr3AzBAsn2L9-V7fEXPsSgV4TDwqtn5FHGtsH0WMPesJAznqc8ziaKszVo6k4dFFDWL_5qZIQeA

# ── Backend (mini-services/api-server/.env — reference list) ──
# PORT=3100
# MONGODB_URI=mongodb://127.0.0.1:27017/slekni
# JWT_SECRET=<long random string>
# SUPER_ADMIN_EMAIL=admin@slekni.dz
# SUPER_ADMIN_PASSWORD=<strong password>
# SUPER_ADMIN_NAME=Super Admin
# VAPID_PUBLIC_KEY=<same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY above>
# VAPID_PRIVATE_KEY=<generated VAPID private key>
# VAPID_SUBJECT=mailto:you@example.com
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# APP_URL=https://your-frontend.vercel.app
# GOOGLE_CLIENT_ID=<Google Cloud Console OAuth Web Client ID>
# GOOGLE_CLIENT_SECRET=<Google OAuth secret>
# GOOGLE_REDIRECT_URI=            # optional; defaults to <server>/api/auth/google/callback
# SMTP_HOST=                      # Magic Link emails (Brevo, Gmail app password, ...)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Selekni w Nselkek <no-reply@slekni.dz>"
# MAGIC_DEV_RETURN_LINK=true      # dev only: return magic link in response instead of email
