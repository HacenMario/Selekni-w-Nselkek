# ══════════════════════════════════════════════════════════════
# Railway → المتغيرات البيئية (Variables) — انسخ ما تحتاجه من هذه القائمة
# الإلزامي للإنتاج: MONGODB_URI + JWT_SECRET (+ APP_URL لتفعيل Google/Magic Link)
# ══════════════════════════════════════════════════════════════
PORT=3100
MONGODB_URI=mongodb://<your-mongodb-uri>
JWT_SECRET=replace_with_long_random_string
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD="replace_with_strong_password"
SUPER_ADMIN_NAME=Super Admin
VAPID_PUBLIC_KEY=replace_with_generated_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_generated_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Frontend origin — Google OAuth / Magic Link redirects land here
APP_URL=http://localhost:3000
# Google OAuth (Google Cloud Console -> OAuth 2.0 Client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to "<this server>/api/auth/google/callback"
GOOGLE_REDIRECT_URI=
# SMTP for Magic Link emails (any provider: Brevo, Gmail app password, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Selekni w Nselkek <no-reply@slekni.dz>"
# Dev only (default true): return the magic link in the API response instead of sending email
MAGIC_DEV_RETURN_LINK=true
